{
  "background_color": "#0f0101",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "icons": [
    {
      "src": "https://www.chyke.online/connectgold_2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "name": "Goldprotechnology",
  "orientation": "any",
  "scope": "/",
  "short_name": "Goldtech",
  "start_url": "/",
  "theme_color": "#000000",
  "lang": "en",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "widgets": [
    {
      "name": "Goldtech Quick Player",
      "description": "Quickly access recent videos and controls.",
      "tag": "player-widget",
      "template": "player-widget-template",
      "ms_ac_template": "/widgets/player-adaptive-card.json",
      "data": "/widgets/player-data.json",
      "type": "application/json",
      "icons": [
        {
          "src": "https://www.chyke.online/connectgold_2.png",
          "sizes": "512x512"
        }
      ]
    }
  ],
  "shortcuts": [
    {
      "name": "Recent",
      "url": "/?page=history",
      "description": "View your recently watched videos"
    },
    {
      "name": "Take Note",
      "url": "/?page=notes",
      "description": "Jot down notes while watching"
    }
  ],
  "categories": [
    "video"
  ],
  "protocol_handlers": [
    {
      "protocol": "web+player",
      "url": "/?open=%s"
    }
  ],
  "share_target": {
    "method": "GET",
    "action": "/?share=video",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "description": "A fast and lightweight video player to watch your favorite videos offline."
}
