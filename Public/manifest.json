{
  "name": "Goldprotechnology",
  "short_name": "Goldtech",
  "description": "A fast and lightweight video player to watch your favorite videos offline.",
  "start_url": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#0f0101",
  "theme_color": "#000000",
  "dir": "ltr",
  "lang": "en",
  "orientation": "any",
  "scope": "/",
  "icons": [
    {
      "src": "https://www.chyke.online/connectgold_2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": [
    "video"
  ],
  "shortcuts": [
    {
      "name": "Recent",
      "url": "/?page=history",
      "description": "View your recently watched videos"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+player",
      "url": "/?open=%s"
    }
  ],
  "share_target": {
    "method": "GET",
    "action": "/?share=video",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
